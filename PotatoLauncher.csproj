<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>Potato Launcher</AssemblyName>
    <RootNamespace>PotatoLauncher</RootNamespace>
    <Version>1.0.91</Version>
    <AssemblyVersion>1.0.91.0</AssemblyVersion>
    <FileVersion>1.0.91.0</FileVersion>
    <InformationalVersion>1.0.91</InformationalVersion>
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Potato Launcher Assets\**\*"
             Exclude="Potato Launcher Assets\Assets\Artemis\*-chroma.png;Potato Launcher Assets\Assets\Artemis\artemis-idle.png;Potato Launcher Assets\Assets\Artemis\artemis-run.png;Potato Launcher Assets\Assets\Artemis\artemis-release.png;Potato Launcher Assets\Assets\Artemis\artemis-wave.png;Potato Launcher Assets\Assets\artemis-welcome-sheet.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
